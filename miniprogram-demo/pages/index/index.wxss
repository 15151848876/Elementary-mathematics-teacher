.pop{animation:pop .4s}
@keyframes pop{0%{transform:scale(.2);opacity:0}70%{transform:scale(1.15)}100%{transform:scale(1);opacity:1}}

/* ---------- v0.3 参数化渲染：竖式板 ---------- */
.vboard{width:100%;padding:10rpx 0 4rpx}
.vline{display:flex;justify-content:center;align-items:flex-end;line-height:1.06}
.vopc{width:66rpx;text-align:center;font-size:44rpx;color:#9aa3b8;flex:0 0 auto}
.vopc.op{font-size:48rpx;color:#7a8499}
.vc{width:62rpx;text-align:center;font-size:56rpx;font-weight:600;color:#1a2233;flex:0 0 auto;font-variant-numeric:tabular-nums}
.vc.wide{font-size:44rpx}
.vc.vlbl{font-size:19rpx;font-weight:400;color:#a3acbf;line-height:2.4;letter-spacing:1rpx}
.vc.hl-a{color:#3b6cff}
.vc.brw{color:#c2560e}
.vc.carry{font-size:24rpx;color:#c2560e;line-height:1.2;font-weight:700}
.vcarry .vc{height:36rpx}
.vrule{height:4rpx;background:#151a24;margin:6rpx 0 8rpx 66rpx}
.vres .vc{color:#2447c9}
.vres .vc.new{color:#0f9d67;animation:pop .38s}

/* ---------- 线段图 ---------- */
.bwrap{padding:16rpx 0 4rpx}
.brow{display:flex;align-items:center;margin-bottom:18rpx}
.blbl{width:66rpx;font-size:21rpx;color:#6b7488;flex:0 0 auto}
.btrack{flex:1;display:flex;align-items:center;min-height:58rpx}
.bseg{height:58rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;font-size:21rpx;font-weight:600;margin-right:3rpx;box-sizing:border-box;overflow:hidden}
.bseg.a{background:#d5e0ff;color:#25419e}
.bseg.b{background:#c9f0dd;color:#0b7d52}
.bseg.d{background:#ffe9d6;color:#c2560e;border:2rpx dashed #ff9a52}
.bval{width:96rpx;text-align:right;font-size:22rpx;font-weight:700;color:#0b7d52;flex:0 0 auto;font-variant-numeric:tabular-nums}
.braces{margin:2rpx 96rpx 0 66rpx}
.brace2{border-bottom:2rpx solid #9aa3b8;padding-bottom:10rpx;margin-bottom:14rpx;text-align:center;font-size:20rpx;color:#6b7488;box-sizing:border-box}
.beq{text-align:center;font-size:25rpx;font-weight:650;color:#0b7d52;margin-top:10rpx}

/* ---------- 面积模型 ---------- */
.awrap{padding:16rpx 0 4rpx}
.agrid{display:flex;flex-wrap:wrap;border-radius:10rpx;overflow:hidden;background:#fff}
.acell{height:76rpx;box-sizing:border-box;border:2rpx solid #d7dfeb;background:#fff}
.acell.a{background:#c3d4ff;border-color:#8fa9ee}
.acell.b{background:#ffd7b5;border-color:#f0a86a}
.aeq{text-align:center;margin-top:20rpx;font-size:26rpx;font-weight:650;color:#2b3a5c}

/* ---------- 数轴 ---------- */
.nlwrap{padding:40rpx 20rpx 20rpx}
.nltrack{position:relative;height:110rpx;border-bottom:3rpx solid #2b3a5c}
.nlmark{position:absolute;top:0;transform:translateX(-50%)}
.nltick{display:block;width:2rpx;height:18rpx;background:#9aa3b8;margin:0 auto}
.nllabel{display:block;text-align:center;font-size:20rpx;color:#7a8499;margin-top:6rpx}
.nlmark.start .nllabel,.nlmark.end .nllabel{color:#3b6cff;font-weight:700}
.nlmark.trail{background:rgba(59,108,255,.08)}
.nljump{position:absolute;top:30rpx;height:34rpx;border-top:4rpx solid #3b6cff;border-radius:4rpx}
.nljump::after{content:'';position:absolute;right:-2rpx;top:-12rpx;border:8rpx solid transparent;border-left-color:#3b6cff}
.nleq{text-align:center;margin-top:28rpx;font-size:28rpx;font-weight:650;color:#2b3a5c}

/* ---------- 小棒与计数器 ---------- */
.ctwrap{padding:20rpx 10rpx}
.ctgroup{margin-bottom:18rpx}
.ctlabel{font-size:22rpx;color:#7a8499;margin-bottom:10rpx}
.ctbundles{display:flex;flex-wrap:wrap;gap:12rpx;align-items:flex-end}
.ctbundle{width:22rpx;height:60rpx;border-radius:6rpx;background:linear-gradient(180deg,#ffb25e,#f28a3a);border:2rpx solid #d9741f}
.ctbundle.hi{background:#3b6cff;border-color:#2447c9}
.ctone{width:22rpx;height:22rpx;border-radius:4rpx;background:#ffd9a8;border:2rpx solid #f0a86a}
.ctone.hi{background:#3b6cff;border-color:#2447c9}
.ctplus{text-align:center;font-size:30rpx;color:#9aa3b8;margin:4rpx 0}
.ctcarry{margin:12rpx 0;padding:12rpx 16rpx;border-radius:12rpx;background:#fff1e5;color:#c2560e;font-size:22rpx;font-weight:650;text-align:center}
.cteq{text-align:center;margin-top:16rpx;font-size:28rpx;font-weight:650;color:#0b7d52}

/* ---------- 几何板 ---------- */
.gbwrap{padding:20rpx 10rpx;position:relative}
.gbgrid{display:grid;gap:4rpx;max-width:520rpx;margin:0 auto;position:relative}
.gbcell{aspect-ratio:1;border-radius:6rpx;background:#f2f5fb;border:2rpx solid #d7dfeb;box-sizing:border-box}
.gbcell.edge{background:#d5e0ff;border-color:#8fa9ee}
.gbcell.all{background:#c3d4ff;border-color:#8fa9ee}
/* 周长示意：一圈彩色粗边框，盖在格子网格上，不画格子、不碰四角 */
.gbperim{position:absolute;inset:0;border:8rpx solid #e8593c;border-radius:10rpx;pointer-events:none;box-sizing:border-box}
.gbeq{text-align:center;margin-top:24rpx;font-size:28rpx;font-weight:650;color:#2b3a5c}

/* ---------- 几何图形（纯 view/CSS，小程序不支持 SVG） ---------- */
.shwrap{padding:12rpx 8rpx;display:flex;flex-direction:column;align-items:center}
.shbox{width:100%;display:flex;justify-content:center;padding:20rpx 0}
.sh-fig{position:relative;width:440rpx;height:280rpx;display:flex;align-items:center;justify-content:center}
.sh-dim{font-size:24rpx;color:#5a6a8c;font-weight:600}

/* 正方形 */
.sq-shape{width:200rpx;height:200rpx;border:5rpx solid #3b4a70;border-radius:8rpx;position:relative;background:#fff;transition:all .3s}
.sq-shape.edge{border-color:#2b5cff;box-shadow:0 0 0 6rpx rgba(43,92,255,.15)}
.sq-shape.filled{background:#d5e0ff;border-color:#2b5cff}
.sq-dim{position:absolute;font-size:24rpx;color:#5a6a8c;font-weight:600}
.sq-dim.bottom{left:50%;transform:translateX(-50%);bottom:-40rpx}

/* 长方形 */
.rect-shape{width:300rpx;height:160rpx;border:5rpx solid #3b4a70;border-radius:8rpx;position:relative;background:#fff;transition:all .3s}
.rect-shape.filled{background:#d5e0ff;border-color:#2b5cff}
.rect-dim{position:absolute;font-size:24rpx;color:#5a6a8c;font-weight:600}
.rect-dim.bottom{left:50%;transform:translateX(-50%);bottom:-40rpx}
.rect-dim.right{right:-50rpx;top:50%;transform:translateY(-50%)}

/* 三角形（直角三角形，clip-path 实现，直角在左下） */
.tri-wrap{position:relative;width:340rpx;height:240rpx}
.tri-shape{width:280rpx;height:180rpx;margin-top:30rpx;margin-left:20rpx;clip-path:polygon(0 100%,100% 100%,100% 0);background:#3b4a70;position:relative;transition:all .3s}
.tri-shape::after{content:'';position:absolute;inset:5rpx;clip-path:polygon(0 100%,100% 100%,100% 0);background:#fff}
.tri-shape.filled::after{background:#d5e0ff}
.tri-dim{position:absolute;font-size:24rpx;color:#5a6a8c;font-weight:600}
.tri-dim.bottom{left:50%;transform:translateX(-50%);bottom:-10rpx}
.tri-dim.right{right:0;top:50%;transform:translateY(-50%)}

/* 圆 */
.circle-wrap{position:relative;width:240rpx;height:240rpx;display:flex;align-items:center;justify-content:center}
.circle-shape{width:200rpx;height:200rpx;border-radius:50%;border:5rpx solid #3b4a70;position:relative;background:#fff;transition:all .3s}
.circle-shape.edge{border-color:#2b5cff;box-shadow:0 0 0 6rpx rgba(43,92,255,.15)}
.circle-shape.filled{background:#d5e0ff;border-color:#2b5cff}
.radius-line{position:absolute;left:50%;top:50%;width:100rpx;height:3rpx;background:#3b4a70;transform-origin:left center;transform:rotate(0)}
.circle-dim{position:absolute;right:-70rpx;top:50%;transform:translateY(-50%);font-size:24rpx;color:#5a6a8c;font-weight:600}

/* 平行四边形 */
.para-wrap{position:relative;width:340rpx;height:240rpx}
.para-shape{width:240rpx;height:150rpx;border:5rpx solid #3b4a70;transform:skewX(-20deg);margin-top:40rpx;margin-left:30rpx;background:#fff;transition:all .3s}
.para-shape.filled{background:#d5e0ff;border-color:#2b5cff}
.para-h{position:absolute;left:60rpx;top:60rpx;width:190rpx;height:0;border-top:3rpx dashed #8a9bcc}
.para-dim{position:absolute;font-size:24rpx;color:#5a6a8c;font-weight:600}
.para-dim.bottom{left:50%;transform:translateX(-50%);bottom:0}
.para-dim.right{right:0;top:50%;transform:translateY(-50%)}

/* 梯形（clip-path） */
.trap-wrap{position:relative;width:340rpx;height:240rpx}
.trap-shape{width:260rpx;height:150rpx;margin-top:40rpx;margin-left:20rpx;clip-path:polygon(20% 0,80% 0,100% 100%,0 100%);background:#fff;border:none;position:relative;transition:all .3s}
.trap-shape::before{content:'';position:absolute;inset:0;clip-path:polygon(20% 0,80% 0,100% 100%,0 100%);background:#fff}
.trap-shape.filled::before{background:#d5e0ff}
.trap-dim{position:absolute;font-size:24rpx;color:#5a6a8c;font-weight:600}
.trap-dim.top{left:50%;transform:translateX(-50%);top:20rpx}
.trap-dim.bottom{left:50%;transform:translateX(-50%);bottom:0}
.trap-dim.right{right:0;top:50%;transform:translateY(-50%)}

/* 组合图形（L形：两块矩形上下叠） */
.comp-wrap{position:relative;width:340rpx;height:260rpx}
.comp-p1{position:absolute;left:40rpx;top:10rpx;width:240rpx;height:130rpx;border:5rpx solid #3b4a70;background:#fff;transition:all .3s}
.comp-p1.filled{background:#d5e0ff;border-color:#2b5cff}
.comp-p2{position:absolute;left:40rpx;top:140rpx;width:140rpx;height:90rpx;border:5rpx solid #3b4a70;background:#fff;transition:all .3s}
.comp-p2.filled{background:#fff;border-color:#2b5cff}
.comp-p2.filled.alt{background:#ffd7b5;border-color:#f0a86a}
.comp-dim{position:absolute;font-size:24rpx;color:#5a6a8c;font-weight:600}
.comp-dim.top{left:50%;transform:translateX(-50%);top:-30rpx}
.comp-dim.left{left:-40rpx;top:50%;transform:translateY(-50%)}
.sheq{text-align:center;margin-top:20rpx;font-size:28rpx;font-weight:650;color:#2b3a5c}

/* ---------- 天平方程 ---------- */
.blwrap{padding:30rpx 10rpx}
.blbeam{display:flex;align-items:flex-start;justify-content:center}
.blpan{width:180rpx;min-height:120rpx;background:#fff;border:3rpx solid #c3cbdb;border-radius:0 0 60rpx 60rpx;border-top:none;padding:16rpx 14rpx 20rpx}
.blpan.left{margin-right:8rpx}
.blpan.right{margin-left:8rpx}
.blpost{width:12rpx;height:90rpx;background:#9aa3b8;border-radius:6rpx;margin-top:10rpx}
.blitems{display:flex;flex-wrap:wrap;gap:8rpx;justify-content:center}
.blnum{width:34rpx;height:34rpx;border-radius:8rpx;background:#e9efff;color:#2447c9;font-size:22rpx;font-weight:650;display:flex;align-items:center;justify-content:center}
.blx{width:34rpx;height:34rpx;border-radius:8rpx;background:#fff1e5;color:#c2560e;font-size:22rpx;font-weight:700;display:flex;align-items:center;justify-content:center;border:2rpx dashed #ff9a52}
.bleq{text-align:center;margin-top:26rpx;font-size:28rpx;font-weight:650;color:#2b3a5c}

/* ---------- 统计图 ---------- */
.chwrap{padding:20rpx 10rpx}
.chplot{display:flex;align-items:flex-end;justify-content:space-around;height:280rpx;padding:10rpx 6rpx 0}
.chcol{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;flex:1}
.chbar{width:46rpx;border-radius:8rpx 8rpx 0 0;background:linear-gradient(180deg,#3b6cff,#5a52e8);min-height:4rpx;transition:height .4s}
.chcol.hi .chbar{background:linear-gradient(180deg,#ff9a52,#f28a3a)}
.chval{font-size:22rpx;font-weight:700;color:#3c465c;margin-top:6rpx}
.chlbl{font-size:20rpx;color:#7a8499;margin-top:4rpx}
.cheq{text-align:center;margin-top:20rpx;font-size:26rpx;font-weight:650;color:#2b3a5c}

/* ---------- 脱式计算 ---------- */
.exwrap{padding:20rpx 10rpx;display:flex;flex-direction:column;gap:16rpx}
.exline{font-size:40rpx;font-weight:700;color:#2b3a5c;text-align:center;letter-spacing:2rpx;padding:12rpx;background:#eef2fb;border-radius:12rpx}
.exstep{display:flex;align-items:center;justify-content:center;gap:14rpx;font-size:34rpx;padding:10rpx}
.exfocus{color:#3b6cff;font-weight:700}
.exres{color:#f28a3a;font-weight:700}
.exfinal{text-align:center;font-size:44rpx;font-weight:800;color:#2b3a5c;padding:12rpx}

/* ---------- 拍照与结果 ---------- */
.shot{position:absolute;left:0;top:0;width:100%;height:100%}
.thumb{width:100%;height:190rpx;border-radius:18rpx;margin-bottom:18rpx;background:#e9eef7}
.errbox{padding:34rpx 28rpx;border-radius:22rpx;background:#fff8ef;border:1rpx solid #f3d9bd}
.errtext{font-size:25rpx;line-height:1.7;color:#8a4b0d;white-space:pre-line;word-break:break-all}
.erractions{display:flex;gap:16rpx;margin-top:24rpx}
.erractions .control-btn{flex:1;margin:0}
.result-actions{display:flex;gap:16rpx;margin-top:20rpx}
.result-actions .control-btn{flex:1;margin:0;padding:18rpx 22rpx;font-size:25rpx}
