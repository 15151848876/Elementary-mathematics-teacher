<view class="page">
  <view class="topbar">
    <view class="brand">数学小步</view>
    <view class="ver">v0.8</view>
    <view class="count">{{solved}} 题已讲</view>
  </view>

  <block wx:if="{{screen === 'home'}}">
    <view class="home-content">
      <view class="greeting">晚上好</view>
      <view class="headline">拍一题，讲一步</view>

      <view class="hero">
        <view class="hero-title">拍试卷 · 分步讲</view>
        <view class="hero-sub">拍下来自动切题<br/>每一步都画出来，不走神</view>
        <view class="hero-actions">
          <button class="hero-btn" bindtap="takePhoto">拍照识别</button>
          <button class="hero-btn" bindtap="useDemo">看示例题</button>
        </view>
      </view>

      <view class="section-head"><text>最近讲过</text><text class="muted">全部 ›</text></view>
      <view class="recent-card" bindtap="useDemo">
        <view class="recent-icon green">竖</view>
        <view class="recent-copy"><view>两位数进位加法</view><text>昨天 · 6 步讲完</text></view>
        <text class="chevron">›</text>
      </view>
      <view class="recent-card" bindtap="useDemo">
        <view class="recent-icon orange">图</view>
        <view class="recent-copy"><view>多几少几应用题</view><text>10 月 29 日 · 7 步讲完</text></view>
        <text class="chevron">›</text>
      </view>

      <view class="demo-note">v0.8：几何板块补齐——正方形、长方形、三角形、组合图形、圆、平行四边形、梯形的周长与面积。「看示例题」会随机抽 3 类演示。</view>
    </view>
  </block>

  <block wx:if="{{screen === 'scan'}}">
    <view class="scan-content">
      <view class="scan-box">
        <image wx:if="{{photo}}" class="shot" src="{{photo}}" mode="aspectFill"/>
        <view wx:else class="paper">
          <view class="paper-line short"></view>
          <view class="paper-line long"></view>
          <view class="paper-line medium"></view>
          <view class="paper-equation">38 + 27 =<text>（第 3 题）</text></view>
          <view class="paper-line long"></view>
          <view class="paper-question">小明有 12 颗糖，小红比小明多 5 颗。</view>
        </view>
        <view class="scan-line"></view>
        <view class="corner tl"></view><view class="corner tr"></view>
        <view class="corner bl"></view><view class="corner br"></view>
      </view>
      <view class="scan-title">{{scanTitle}}<text>请保持画面稳定</text></view>
      <view class="scan-tasks">
        <view wx:for="{{scanTasks}}" wx:key="label" class="scan-task {{item.state}}">
          <view class="task-dot">{{item.state === 'done' ? '✓' : ''}}</view><text>{{item.label}}</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{screen === 'results'}}">
    <view class="results-content">
      <view wx:if="{{errMsg}}" class="errbox">
        <view class="errtext">{{errMsg}}</view>
        <view class="erractions">
          <button class="control-btn" bindtap="goHome">回首页</button>
          <button class="control-btn primary" bindtap="retry">重新拍一张</button>
        </view>
      </view>

      <block wx:if="{{questions.length}}">
        <view class="result-head">
          <view>找到 {{questions.length}} 道题</view>
          <text>{{source === 'mock' ? '本地示例识别' : '模型识别'}}</text>
        </view>

        <image wx:if="{{photo}}" class="thumb" src="{{photo}}" mode="aspectFill"/>

        <view wx:for="{{questions}}" wx:key="id" class="question-card" data-index="{{index}}" bindtap="openQuestion">
          <view class="question-no">第 {{item.no}} 题 · {{item.templateName}}</view>
          <view class="question-stem">{{item.stem}}</view>
          <view class="tags"><text class="tag blue">{{item.tag}}</text><text class="tag">{{item.topic}}</text><text class="tag confidence">{{item.confidence}}%</text></view>
          <text class="question-arrow">›</text>
        </view>

        <view class="save-note">每道题的步骤都是引擎现算的，不是提前写死的</view>
      </block>
    </view>
  </block>

  <block wx:if="{{screen === 'solve'}}">
    <view class="solve-top">
      <view class="back" bindtap="backToResults">←</view>
      <view class="solve-meta"><view>{{current.tag}}</view><text>{{current.topic}} · {{current.templateName}}</text></view>
      <view class="step-count"><text>{{stepIndex + 1}}</text>/{{current.steps.length}}</view>
    </view>
    <view class="solve-content">
      <view class="problem-stem">{{current.stem}}</view>

      <view class="canvas-card">
        <block wx:if="{{snap.kind === 'vertical'}}">
          <view class="vboard">
            <view class="vline">
              <text class="vopc"></text>
              <text class="vc vlbl" wx:for="{{snap.colLabels}}" wx:key="*this">{{item}}</text>
            </view>
            <view class="vline">
              <text class="vopc"></text>
              <text class="vc {{item.cls}}" wx:for="{{snap.aCells}}" wx:key="i">{{item.ch}}</text>
            </view>
            <view class="vline">
              <text class="vopc op">{{snap.op}}</text>
              <text class="vc {{item.cls}}" wx:for="{{snap.bCells}}" wx:key="i">{{item.ch}}</text>
            </view>
            <view class="vline vcarry">
              <text class="vopc"></text>
              <text class="vc {{item.cls}}" wx:for="{{snap.carryCells}}" wx:key="i">{{item.ch}}</text>
            </view>
            <view class="vrule"></view>
            <view class="vline vres">
              <text class="vopc"></text>
              <text class="vc {{item.cls}}" wx:for="{{snap.resCells}}" wx:key="i">{{item.ch}}</text>
            </view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'bar'}}">
          <view class="bwrap">
            <view class="brow" wx:for="{{snap.rows}}" wx:key="i">
              <text class="blbl">{{item.label}}</text>
              <view class="btrack">
                <view class="bseg {{seg.cls}}" wx:for="{{item.segs}}" wx:for-item="seg" wx:key="i" style="width:{{seg.pct}}%">{{seg.text}}</view>
              </view>
              <text class="bval">{{item.value}}</text>
            </view>
            <view class="braces" wx:if="{{snap.braces.length}}">
              <view class="brace2" wx:for="{{snap.braces}}" wx:key="i" style="margin-left:{{item.leftPct}}%;width:{{item.widthPct}}%">{{item.text}}</view>
            </view>
            <view class="beq" wx:if="{{snap.eq}}">{{snap.eq}}</view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'area'}}">
          <view class="awrap">
            <view class="agrid">
              <view class="acell {{item.cls}}" wx:for="{{snap.cells}}" wx:key="i" style="width:{{snap.cellW}}%"></view>
            </view>
            <view class="aeq" wx:if="{{snap.eq}}">{{snap.eq}}</view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'numberline'}}">
          <view class="nlwrap">
            <view class="nltrack">
              <view class="nlmark {{item.cls}}" wx:for="{{snap.marks}}" wx:key="i" style="left:{{item.i * snap.unitW}}%">
                <text class="nltick"></text>
                <text class="nllabel" wx:if="{{item.label}}">{{item.label}}</text>
              </view>
              <view wx:if="{{snap.jump}}" class="nljump" style="left:{{snap.jump.from * snap.unitW}}%;width:{{(snap.jump.to - snap.jump.from) * snap.unitW}}%"></view>
            </view>
            <view class="nleq" wx:if="{{snap.eq}}">{{snap.eq}}</view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'counter'}}">
          <view class="ctwrap">
            <view class="ctgroup">
              <view class="ctlabel">被加数 {{snap.a.bundles.length}}0 + {{snap.a.ones.length}}</view>
              <view class="ctbundles">
                <view class="ctbundle {{item.cls}}" wx:for="{{snap.a.bundles}}" wx:key="i"></view>
                <view class="ctone {{item.cls}}" wx:for="{{snap.a.ones}}" wx:key="i"></view>
              </view>
            </view>
            <view class="ctplus">+</view>
            <view class="ctgroup">
              <view class="ctlabel">加数 {{snap.b.bundles.length}}0 + {{snap.b.ones.length}}</view>
              <view class="ctbundles">
                <view class="ctbundle {{item.cls}}" wx:for="{{snap.b.bundles}}" wx:key="i"></view>
                <view class="ctone {{item.cls}}" wx:for="{{snap.b.ones}}" wx:key="i"></view>
              </view>
            </view>
            <view wx:if="{{snap.carry}}" class="ctcarry">{{snap.carryText}}</view>
            <view class="cteq" wx:if="{{snap.eq}}">{{snap.eq}}</view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'geoboard'}}">
          <view class="gbwrap">
            <view class="gbgrid" style="grid-template-columns:repeat({{snap.cols}},1fr)">
              <view class="gbcell {{item.cls}}" wx:for="{{snap.cells}}" wx:key="i"></view>
            </view>
            <view class="gbeq" wx:if="{{snap.eq}}">{{snap.eq}}</view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'shape'}}">
          <view class="shwrap">
            <view class="shsvg">
              <!-- 正方形 -->
              <svg wx:if="{{snap.shape === 'square'}}" viewBox="0 0 200 200" class="sh-svg">
                <rect x="40" y="40" width="120" height="120" class="sh-fill {{snap.hl === 'area' ? 'on' : ''}}" rx="2" />
                <rect x="40" y="40" width="120" height="120" fill="none" class="sh-stroke {{snap.hl === 'peri' ? 'on' : ''}}" stroke-width="3" />
                <text x="100" y="180" text-anchor="middle" class="sh-dim">{{snap.a}}</text>
                <text x="100" y="105" text-anchor="middle" class="sh-dim dark">{{snap.a}}</text>
              </svg>
              <!-- 长方形 -->
              <svg wx:elif="{{snap.shape === 'rect'}}" viewBox="0 0 240 160" class="sh-svg">
                <rect x="30" y="40" width="180" height="80" fill="none" class="sh-stroke" stroke-width="3" />
                <rect x="30" y="40" width="180" height="80" class="sh-fill {{snap.hl === 'area' || snap.hl === 'check' ? 'on' : ''}}" rx="2" />
                <text x="120" y="145" text-anchor="middle" class="sh-dim">{{snap.a}}</text>
                <text x="10" y="85" text-anchor="middle" class="sh-dim">{{snap.b || '?'}}</text>
              </svg>
              <!-- 三角形 -->
              <svg wx:elif="{{snap.shape === 'triangle'}}" viewBox="0 0 220 160" class="sh-svg">
                <polygon points="30,130 190,130 190,50" class="sh-fill {{snap.hl === 'area' ? 'on' : ''}}" />
                <polygon points="30,130 190,130 190,50" fill="none" class="sh-stroke" stroke-width="3" />
                <line x1="190" y1="50" x2="190" y2="130" stroke-dasharray="4,3" class="sh-dash" stroke-width="2" />
                <text x="110" y="152" text-anchor="middle" class="sh-dim">{{snap.a}}</text>
                <text x="205" y="92" text-anchor="middle" class="sh-dim">{{snap.b}}</text>
              </svg>
              <!-- 组合图形（L形：两块矩形） -->
              <svg wx:elif="{{snap.shape === 'composite'}}" viewBox="0 0 240 200" class="sh-svg">
                <rect x="40" y="40" width="120" height="90" class="sh-fill {{snap.hl === 'p1' ? 'on' : (snap.hl === 'sum' ? 'on' : '')}}" />
                <rect x="40" y="40" width="120" height="90" fill="none" class="sh-stroke" stroke-width="3" />
                <rect x="40" y="130" width="70" height="50" class="sh-fill alt {{snap.hl === 'p2' ? 'on' : (snap.hl === 'sum' ? 'on' : '')}}" />
                <rect x="40" y="130" width="70" height="50" fill="none" class="sh-stroke" stroke-width="3" />
                <text x="100" y="30" text-anchor="middle" class="sh-dim">{{snap.a}}</text>
                <text x="25" y="90" text-anchor="middle" class="sh-dim">{{snap.b}}</text>
                <text x="75" y="198" text-anchor="middle" class="sh-dim">{{snap.c}}</text>
                <text x="18" y="158" text-anchor="middle" class="sh-dim">{{snap.d}}</text>
              </svg>
              <!-- 圆 -->
              <svg wx:elif="{{snap.shape === 'circle'}}" viewBox="0 0 200 200" class="sh-svg">
                <circle cx="100" cy="100" r="70" class="sh-fill {{snap.hl === 'area' ? 'on' : ''}}" />
                <circle cx="100" cy="100" r="70" fill="none" class="sh-stroke {{snap.hl === 'peri' ? 'on' : ''}}" stroke-width="3" />
                <line x1="100" y1="100" x2="170" y2="100" class="sh-stroke" stroke-width="2" />
                <circle cx="100" cy="100" r="3" fill="#3b4a70" />
                <text x="132" y="92" text-anchor="middle" class="sh-dim">{{snap.a}}</text>
              </svg>
              <!-- 平行四边形 -->
              <svg wx:elif="{{snap.shape === 'parallelogram'}}" viewBox="0 0 240 160" class="sh-svg">
                <polygon points="50,130 170,130 210,50 90,50" class="sh-fill {{snap.hl === 'area' || snap.hl === 'cut' ? 'on' : ''}}" />
                <polygon points="50,130 170,130 210,50 90,50" fill="none" class="sh-stroke" stroke-width="3" />
                <line x1="170" y1="50" x2="170" y2="130" stroke-dasharray="4,3" class="sh-dash" stroke-width="2" />
                <text x="130" y="152" text-anchor="middle" class="sh-dim">{{snap.a}}</text>
                <text x="185" y="92" text-anchor="middle" class="sh-dim">{{snap.b}}</text>
              </svg>
              <!-- 梯形 -->
              <svg wx:elif="{{snap.shape === 'trapezoid'}}" viewBox="0 0 240 160" class="sh-svg">
                <polygon points="70,50 190,50 220,130 40,130" class="sh-fill {{snap.hl === 'area' ? 'on' : ''}}" />
                <polygon points="70,50 190,50 220,130 40,130" fill="none" class="sh-stroke" stroke-width="3" />
                <line x1="130" y1="50" x2="130" y2="130" stroke-dasharray="4,3" class="sh-dash" stroke-width="2" />
                <text x="130" y="40" text-anchor="middle" class="sh-dim">{{snap.a}}</text>
                <text x="130" y="152" text-anchor="middle" class="sh-dim">{{snap.b}}</text>
                <text x="143" y="92" text-anchor="middle" class="sh-dim">{{snap.c}}</text>
              </svg>
            </view>
            <view class="sheq" wx:if="{{snap.eq}}">{{snap.eq}}</view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'balance'}}">
          <view class="blwrap">
            <view class="blbeam">
              <view class="blpan left">
                <view class="blitems">
                  <view class="blx" wx:for="{{snap.x}}" wx:key="*this">x</view>
                  <view class="blnum" wx:for="{{snap.left}}" wx:key="*this">{{item}}</view>
                </view>
              </view>
              <view class="blpost"></view>
              <view class="blpan right">
                <view class="blitems">
                  <view class="blnum" wx:for="{{snap.right}}" wx:key="*this">{{item}}</view>
                </view>
              </view>
            </view>
            <view class="bleq" wx:if="{{snap.eq}}">{{snap.eq}}</view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'chart'}}">
          <view class="chwrap">
            <view class="chplot">
              <view class="chcol {{item.cls}}" wx:for="{{snap.bars}}" wx:key="i">
                <view class="chbar" style="height:{{item.pct}}%"></view>
                <text class="chval">{{item.v}}</text>
                <text class="chlbl">{{item.label}}</text>
              </view>
            </view>
            <view class="cheq" wx:if="{{snap.eq}}">{{snap.eq}}</view>
          </view>
        </block>

        <block wx:elif="{{snap.kind === 'expression'}}">
          <view class="exwrap">
            <view class="exline">{{snap.expr}}</view>
            <view class="exstep" wx:if="{{snap.aText}}">
              <text class="exfocus">{{snap.aText}} {{snap.op}} {{snap.bText}}</text>
              <text class="exres">= {{snap.result}}</text>
            </view>
            <view class="exfinal" wx:if="{{snap.final}}">
              <text class="exfocus">{{snap.result}}</text>
            </view>
          </view>
        </block>
      </view>

      <view class="narration">
        <view class="narr-step">{{isAsk ? '想一想' : '第 ' + (stepIndex + 1) + ' 步'}}</view>
        <view class="narr-title">{{stepTitle}}</view>
        <view class="narr-text">{{stepText}}</view>
      </view>

      <view wx:if="{{isAsk}}" class="ask-card {{answered ? 'answered' : ''}}">
        <view class="ask-title"><text>{{answered ? '答对了' : '想一想'}}</text>{{ask.question}}</view>
        <view class="ask-options"><button wx:for="{{ask.options}}" wx:key="*this" data-index="{{index}}" class="ask-option {{answered && index === ask.answer ? 'correct' : ''}} {{wrongIndex === index ? 'wrong' : ''}}" bindtap="answerQuestion">{{item}}</button></view>
        <view wx:if="{{answered}}" class="ask-hint">{{ask.hint}}</view>
      </view>

      <view class="controls">
        <button class="control-btn" disabled="{{stepIndex === 0}}" bindtap="prevStep">上一步</button>
        <view class="step-dots">
          <view wx:for="{{current.steps}}" wx:key="idx" class="dot {{index === stepIndex ? 'on' : ''}} {{index < stepIndex ? 'done' : ''}}"></view>
        </view>
        <button class="control-btn primary" disabled="{{isAsk && !answered}}" bindtap="nextStep">{{stepIndex === current.steps.length - 1 ? '完成' : '下一步'}}</button>
      </view>
    </view>
  </block>
</view>
